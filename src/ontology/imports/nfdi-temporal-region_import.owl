     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo/imports/nfdi-temporal-region_import.owl">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-01</terms:created>
        <terms:source rdf:resource="https://ontoboard.org/patterns/nfdi-temporal-region.owl"/>
    </owl:Ontology>
    


