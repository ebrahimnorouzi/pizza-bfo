<?xml version="1.0"?>
<rdf:RDF xmlns="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo/imports/bfo_process_site_and_history_import.owl#"
     xml:base="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo/imports/bfo_process_site_and_history_import.owl"
