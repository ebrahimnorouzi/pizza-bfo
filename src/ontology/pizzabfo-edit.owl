    <!-- https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001000 -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001003"/>
                <owl:someValuesFrom rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An oven-baked flat bread with toppings: an object with a base and toppings as its parts.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">pizza</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001001 -->

    <owl:Class rdf:about="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
        <obo:IAO_0000115 xml:lang="en">The baked dough of a pizza that its toppings rest on, a part of the pizza.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">pizza base</rdfs:label>
    </owl:Class>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001002 -->

