    <!-- https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001003 -->

    <owl:ObjectProperty rdf:about="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001003">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
        <rdfs:domain rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001000"/>
        <rdfs:range rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001001"/>
        <obo:IAO_0000115 xml:lang="en">Relates a pizza to the base that is a part of it.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has base</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001004 -->

    <owl:ObjectProperty rdf:about="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001004">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
        <rdfs:domain rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001000"/>
        <rdfs:range rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001002"/>
        <obo:IAO_0000115 xml:lang="en">Relates a pizza to a topping that is a part of it.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has topping</rdfs:label>
    </owl:ObjectProperty>
    


