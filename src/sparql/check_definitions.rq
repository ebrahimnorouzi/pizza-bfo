# Every term of this ontology must have a definition (IAO_0000115)
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
SELECT ?term WHERE {
  { ?term a owl:Class } UNION { ?term a owl:ObjectProperty }
  FILTER(STRSTARTS(STR(?term), "https://ebrahimnorouzi.github.io/pizza-bfo/"))
  FILTER NOT EXISTS { ?term obo:IAO_0000115 ?definition }
}
