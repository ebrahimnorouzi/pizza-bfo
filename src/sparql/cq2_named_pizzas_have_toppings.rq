# CQ2: every named pizza must say which toppings it has
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?pizza WHERE {
  ?named rdfs:label "named pizza"@en .
  ?hasTopping rdfs:label "has topping"@en .
  ?pizza rdfs:subClassOf ?named .
  FILTER NOT EXISTS {
    ?pizza rdfs:subClassOf ?restriction .
    ?restriction owl:onProperty ?hasTopping ; owl:someValuesFrom ?topping .
  }
}
