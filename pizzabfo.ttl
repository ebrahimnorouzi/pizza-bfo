                                                              rdfs:label "cheese topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001008
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001008> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001002> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping made of meat."@en ;
                                                              rdfs:label "meat topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001009
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001009> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001002> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping made of a vegetable."@en ;
                                                              rdfs:label "vegetable topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001010
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001010> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001002> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping made of fruit."@en ;
                                                              rdfs:label "fruit topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001011
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001011> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001007> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of mozzarella."@en ;
                                                              rdfs:label "mozzarella topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001012
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001012> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001007> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of parmesan."@en ;
                                                              rdfs:label "parmesan topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001013
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001013> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001007> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of gorgonzola."@en ;
                                                              rdfs:label "gorgonzola topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001014
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001014> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001008> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of ham."@en ;
                                                              rdfs:label "ham topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001015
<https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001015> rdf:type owl:Class ;
                                                              rdfs:subClassOf <https://ebrahimnorouzi.github.io/pizza-bfo/PIZZABFO_0001008> ;
                                                              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of spicy salami."@en ;
