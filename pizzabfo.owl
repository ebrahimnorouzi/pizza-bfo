<?xml version="1.0"?>
<rdf:RDF xmlns="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo.owl#"
     xml:base="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo.owl">
        <owl:versionIRI rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo/0.2.0"/>
        <terms:description xml:lang="en">A pizza ontology aligned to BFO 2020 - the BFO that NFDIcore 3.0.5 builds on - and made from BFO and NFDIcore design patterns. It holds no individuals: its instance data is a separate knowledge graph built from ROBOT templates.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Pizza BFO Ontology</terms:title>
        <rdfs:label xml:lang="en">Pizza BFO Ontology</rdfs:label>
        <owl:priorVersion rdf:resource="https://ebrahimnorouzi.github.io/pizza-bfo/pizzabfo/0.1.0"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.2.0</owl:versionInfo>
    </owl:Ontology>
    


